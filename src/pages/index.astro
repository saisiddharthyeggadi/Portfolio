---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import CurrentFocus from '../components/CurrentFocus.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Achievements from '../components/Achievements.astro';
import Contact from '../components/Contact.astro';
import ResumeModal from '../components/ResumeModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Yeggadi Sai Siddharth | Systems Development & AI Engineer">
  <!-- Navigation Header -->
  <Header />

  <!-- Main Single Page Content -->
  <main class="space-y-4">
    <Hero />
    <About />
    <CurrentFocus />
    <Experience />
    <Skills />
    <Projects />
    <Achievements />
    <Contact />
  </main>

  <!-- Interactive Resume Modal -->
  <ResumeModal />

  <!-- Footer -->
  <Footer />
</Layout>
