---
import { personalData } from '../data/portfolioData';
---

<section id="hero" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Tokyo Status Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-400 text-xs font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          <span>Bilingual Systems & AI Engineer in Tokyo 🇯🇵</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15]">
          Architecting Next-Gen <br class="hidden sm:block" />
          <span class="orange-gradient-text">Multi-Agent RAG</span> & <br class="hidden sm:block" />
          Full-Stack AI Systems
        </h1>

        <!-- Animated Subtitle / Typing -->
        <p class="text-lg sm:text-xl text-gray-400 dark:text-gray-400 light:text-slate-600 font-normal max-w-2xl leading-relaxed">
          Hi, I'm <strong class="text-gray-100 dark:text-gray-100 light:text-slate-900 font-semibold">{personalData.name}</strong> — 
          <span id="hero-typed-text" class="text-orange-400 font-mono font-medium"></span>
          <span class="animate-pulse text-orange-400">|</span>
        </p>

        <p class="text-sm sm:text-base text-gray-400 dark:text-gray-400 light:text-slate-600 max-w-2xl">
          IIT Hyderabad graduate with proven production experience deploying enterprise AI agent pipelines on Google Cloud, optimizing LLMs at Kore.ai, and engineering scalable web applications.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-4">
          <a
            href="#projects"
            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-semibold text-sm shadow-glow-orange transition-all duration-300 hover:scale-[1.02] flex items-center gap-2"
          >
            <span>Explore Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <button
            id="hero-open-resume"
            class="px-6 py-3.5 rounded-xl bg-gray-900/80 dark:bg-gray-900/80 light:bg-slate-200 border border-gray-800 dark:border-gray-800 light:border-slate-300 hover:border-orange-500/50 text-gray-200 dark:text-gray-200 light:text-slate-800 font-semibold text-sm transition-all duration-300 flex items-center gap-2 group"
          >
            <svg class="w-4 h-4 text-orange-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>View Resumes (4)</span>
          </button>

          <a
            href="#contact"
            class="px-4 py-3 text-sm text-gray-400 hover:text-orange-400 transition-colors flex items-center gap-1"
          >
            <span>Get in Touch</span>
            <span>→</span>
          </a>
        </div>

        <!-- Social Quick Links -->
        <div class="flex items-center gap-6 pt-4 text-gray-400 text-xs font-mono">
          <a href={personalData.github} target="_blank" rel="noopener noreferrer" class="hover:text-orange-400 transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub</span>
          </a>
          <a href={personalData.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-orange-400 transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.262-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>LinkedIn</span>
          </a>
          <span class="text-gray-600">|</span>
          <span class="text-emerald-400 font-semibold">JLPT N2 (Passed Exam)</span>
        </div>

      </div>

      <!-- Right Feature Cards / Metrics -->
      <div class="lg:col-span-5 relative">
        <!-- Glowing Halo -->
        <div class="absolute -inset-1 bg-gradient-to-r from-orange-500 to-amber-500 rounded-3xl blur-xl opacity-30 animate-pulse-slow"></div>

        <div class="relative glass-panel rounded-3xl p-6 sm:p-8 space-y-6 orange-glow-border">
          
          <div class="flex items-center justify-between border-b border-gray-800 pb-4">
            <div>
              <p class="text-xs text-orange-400 font-mono uppercase tracking-wider font-semibold">Core Expertise</p>
              <h2 class="text-xl font-bold text-gray-100 dark:text-gray-100 light:text-slate-900">Engineering Metrics</h2>
            </div>
            <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 text-xl font-bold">
              ⚡
            </div>
          </div>

          <!-- Quick Stats Grid -->
          <div class="grid grid-cols-2 gap-4">
            {personalData.stats.map(stat => (
              <div class="bg-gray-900/60 dark:bg-gray-900/60 light:bg-slate-100 p-4 rounded-2xl border border-gray-800/80 dark:border-gray-800/80 light:border-slate-200">
                <span class="text-2xl sm:text-3xl font-extrabold text-orange-400 font-mono">{stat.value}</span>
                <p class="text-xs font-semibold text-gray-200 dark:text-gray-200 light:text-slate-800 mt-1">{stat.label}</p>
                <p class="text-[10px] text-gray-400 dark:text-gray-400 light:text-slate-500 mt-0.5">{stat.subtext}</p>
              </div>
            ))}
          </div>

          <!-- Current Role Banner -->
          <div class="bg-gradient-to-r from-orange-500/10 to-amber-500/10 border border-orange-500/30 p-4 rounded-2xl flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-500/20 border border-orange-500/40 flex items-center justify-center text-2xl">
              🏢
            </div>
            <div>
              <p class="text-xs text-orange-400 font-mono font-semibold">Current Position</p>
              <p class="text-sm font-bold text-gray-100 dark:text-gray-100 light:text-slate-900">Systems Development Engineer</p>
              <p class="text-xs text-gray-400 dark:text-gray-400 light:text-slate-600">Tomato CO., Ltd. • Tokyo, Japan 🇯🇵</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Dynamic Typing Subtitle Script
  const roles = [
    "Multi-Agent RAG Architect",
    "Systems Development Engineer",
    "Full-Stack Web Developer",
    "IIT Hyderabad Alum"
  ];
  
  let roleIdx = 0;
  let charIdx = 0;
  let isDeleting = false;
  const typedEl = document.getElementById('hero-typed-text');

  function typeEffect() {
    if (!typedEl) return;
    const currentRole = roles[roleIdx];
    
    if (isDeleting) {
      typedEl.textContent = currentRole.substring(0, charIdx - 1);
      charIdx--;
    } else {
      typedEl.textContent = currentRole.substring(0, charIdx + 1);
      charIdx++;
    }

    let typeSpeed = isDeleting ? 40 : 80;

    if (!isDeleting && charIdx === currentRole.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIdx === 0) {
      isDeleting = false;
      roleIdx = (roleIdx + 1) % roles.length;
      typeSpeed = 500;
    }

    setTimeout(typeEffect, typeSpeed);
  }

  document.addEventListener('DOMContentLoaded', typeEffect);

  // Bind Resume Button in Hero
  document.getElementById('hero-open-resume')?.addEventListener('click', () => {
    document.getElementById('open-resume-btn')?.click();
  });
</script>
