---
import { personalData } from '../data/portfolioData';
---

<section id="hero" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Primary Headline & Intro -->
      <div class="lg:col-span-7 space-y-6 text-left">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-slate-700 dark:text-gray-300 font-semibold">Systems Development Engineer</span>
          <span class="text-slate-400 dark:text-gray-500">|</span>
          <span class="text-orange-600 dark:text-orange-400 font-semibold">Tokyo, Japan</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-none text-slate-900 dark:text-gray-100">
          Building Enterprise <br />
          <span class="text-orange-600 dark:text-orange-400">Multi-Agent AI & Web Systems</span>
        </h1>

        <!-- Subtitle with Dynamic Typing Effect -->
        <p class="text-base sm:text-lg text-slate-700 dark:text-gray-300 font-medium max-w-2xl leading-relaxed">
          I am <strong class="text-slate-900 dark:text-gray-100 font-semibold">{personalData.name}</strong>, an IIT Hyderabad graduate engineer based in Tokyo specializing in
          <span id="typed-text" class="text-orange-600 dark:text-orange-400 font-mono font-semibold"></span>
          <span class="animate-pulse text-orange-600">|</span>
        </p>

        <!-- Concise Professional Bio -->
        <p class="text-xs sm:text-sm text-slate-600 dark:text-gray-400 max-w-2xl leading-relaxed">
          Currently developing Google Cloud Multi-Agent RAG platforms and localized web infrastructure at Tomato CO., Ltd. in Tokyo. Experienced across Python, PyTorch, Node.js, Angular, and cloud-native toolcalling systems.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="#projects"
            class="px-6 py-3 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm transition-colors shadow-sm"
          >
            View Featured Projects
          </a>

          <a
            href="#contact"
            class="px-6 py-3 rounded-xl bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-slate-800 dark:text-gray-200 hover:border-orange-500/50 font-semibold text-sm transition-colors"
          >
            Contact Direct
          </a>

          <button
            id="hero-open-resume"
            class="px-5 py-3 rounded-xl bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-orange-600 dark:text-orange-400 font-mono text-xs font-semibold hover:border-orange-500/50 transition-colors flex items-center gap-1.5"
          >
            <span>View Resumes</span>
            <span>-&gt;</span>
          </button>
        </div>

        <!-- Quick Contacts -->
        <div class="pt-6 flex flex-wrap items-center gap-6 text-xs text-slate-600 dark:text-gray-400 font-mono font-medium">
          <a href={personalData.github} target="_blank" rel="noopener noreferrer" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
            GitHub: saisiddharthyeggadi
          </a>
          <span>/</span>
          <a href={personalData.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
            LinkedIn: yeggadi-sai-siddharth
          </a>
        </div>

      </div>

      <!-- Right Column: Key Professional Metrics Grid -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-4">
        {personalData.stats.map(stat => (
          <div class="formal-card rounded-2xl p-5 space-y-2">
            <p class="text-xs text-orange-600 dark:text-orange-400 font-mono font-semibold">
              {stat.label}
            </p>
            <p class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-gray-100">
              {stat.value}
            </p>
            <p class="text-[11px] text-slate-600 dark:text-gray-400 leading-snug">
              {stat.subtext}
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  const phrases = [
    "Enterprise Multi-Agent RAG Systems",
    "Production GenAI & Prompt Guardrails",
    "Computer Vision & Deep Learning",
    "Full-Stack TypeScript & Python Systems"
  ];
  
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const typedTextEl = document.getElementById('typed-text');

  function typeEffect() {
    if (!typedTextEl) return;
    const currentPhrase = phrases[phraseIndex];

    if (isDeleting) {
      typedTextEl.textContent = currentPhrase.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typedTextEl.textContent = currentPhrase.substring(0, charIndex + 1);
      charIndex++;
    }

    let typeSpeed = isDeleting ? 30 : 60;

    if (!isDeleting && charIndex === currentPhrase.length) {
      typeSpeed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      typeSpeed = 500;
    }

    setTimeout(typeEffect, typeSpeed);
  }

  document.addEventListener('DOMContentLoaded', typeEffect);

  document.getElementById('hero-open-resume')?.addEventListener('click', () => {
    document.getElementById('resume-modal')?.classList.remove('hidden');
  });
</script>
