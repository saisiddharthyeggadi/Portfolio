---
import { personalData } from '../data/portfolioData';
---

<header class="fixed top-0 left-0 right-0 z-40 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#hero" class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-600 to-amber-400 p-[2px] shadow-glow-orange transition-transform duration-300 group-hover:scale-105">
        <div class="w-full h-full bg-[#0b0f17] dark:bg-[#0b0f17] light:bg-white rounded-[10px] flex items-center justify-center font-bold text-orange-400 text-lg">
          SS
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-base tracking-tight text-gray-100 dark:text-gray-100 light:text-slate-900 group-hover:text-orange-400 transition-colors">
          Sai Siddharth
        </span>
        <span class="text-xs text-orange-400/90 font-mono flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          Tokyo, Japan 🇯🇵
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 bg-gray-900/60 dark:bg-gray-900/60 light:bg-white/70 p-1.5 rounded-full border border-gray-800/80 dark:border-gray-800/80 light:border-gray-200">
      <a href="#about" class="px-4 py-1.5 rounded-full text-xs font-medium text-gray-300 dark:text-gray-300 light:text-slate-600 hover:text-orange-400 hover:bg-orange-500/10 transition-all">About</a>
      <a href="#experience" class="px-4 py-1.5 rounded-full text-xs font-medium text-gray-300 dark:text-gray-300 light:text-slate-600 hover:text-orange-400 hover:bg-orange-500/10 transition-all">Experience</a>
      <a href="#skills" class="px-4 py-1.5 rounded-full text-xs font-medium text-gray-300 dark:text-gray-300 light:text-slate-600 hover:text-orange-400 hover:bg-orange-500/10 transition-all">Skills</a>
      <a href="#projects" class="px-4 py-1.5 rounded-full text-xs font-medium text-gray-300 dark:text-gray-300 light:text-slate-600 hover:text-orange-400 hover:bg-orange-500/10 transition-all">Projects</a>
      <a href="#achievements" class="px-4 py-1.5 rounded-full text-xs font-medium text-gray-300 dark:text-gray-300 light:text-slate-600 hover:text-orange-400 hover:bg-orange-500/10 transition-all">Achievements</a>
      <a href="#contact" class="px-4 py-1.5 rounded-full text-xs font-medium text-gray-300 dark:text-gray-300 light:text-slate-600 hover:text-orange-400 hover:bg-orange-500/10 transition-all">Contact</a>
    </nav>

    <!-- Header Action Buttons -->
    <div class="flex items-center gap-3">
      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle-btn"
        aria-label="Toggle Theme"
        class="p-2.5 rounded-xl bg-gray-900/80 dark:bg-gray-900/80 light:bg-slate-200 border border-gray-800 dark:border-gray-800 light:border-slate-300 text-gray-300 dark:text-gray-300 light:text-slate-700 hover:text-orange-400 hover:border-orange-500/40 transition-all"
      >
        <!-- Sun Icon (Dark Mode active) -->
        <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon Icon (Light Mode active) -->
        <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Resume Trigger Button -->
      <button
        id="open-resume-btn"
        class="relative inline-flex items-center justify-center p-0.5 overflow-hidden text-xs font-semibold rounded-xl group bg-gradient-to-r from-orange-500 to-amber-500 group-hover:from-orange-600 group-hover:to-amber-600 text-white shadow-glow-orange transition-all duration-300"
      >
        <span class="relative px-4 py-2 transition-all ease-in duration-75 bg-[#0b0f17] dark:bg-[#0b0f17] light:bg-white text-orange-400 dark:text-orange-400 light:text-orange-600 rounded-[10px] group-hover:bg-transparent group-hover:text-white flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Resumes</span>
        </span>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Open Navigation Menu"
        class="md:hidden p-2 rounded-xl bg-gray-900/80 border border-gray-800 text-gray-400 hover:text-white"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-gray-950/95 border-b border-gray-800 px-6 py-4 space-y-3">
    <a href="#about" class="block text-sm font-medium text-gray-300 hover:text-orange-400">About</a>
    <a href="#experience" class="block text-sm font-medium text-gray-300 hover:text-orange-400">Experience</a>
    <a href="#skills" class="block text-sm font-medium text-gray-300 hover:text-orange-400">Skills</a>
    <a href="#projects" class="block text-sm font-medium text-gray-300 hover:text-orange-400">Projects</a>
    <a href="#achievements" class="block text-sm font-medium text-gray-300 hover:text-orange-400">Achievements</a>
    <a href="#contact" class="block text-sm font-medium text-gray-300 hover:text-orange-400">Contact</a>
  </div>
</header>

<script>
  // Theme Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  
  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });

  // Mobile Menu Logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu on click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
