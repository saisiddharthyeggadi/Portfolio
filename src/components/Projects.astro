---
import { projectsData } from '../data/portfolioData';
---

<section id="projects" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono font-semibold">
        <span>// FEATURED PROJECTS & SYSTEMS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Production Engineering <span class="orange-gradient-text">& Open-Source Work</span>
      </h2>
      <p class="text-gray-400 dark:text-gray-400 light:text-slate-600 text-base">
        Select projects spanning enterprise Multi-Agent RAG, full-stack applications, and deep learning pipelines.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-6">
        <button
          class="project-tab-btn active px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-orange-500 text-white border-orange-500 shadow-glow-orange"
          data-category="all"
        >
          All Projects ({projectsData.length})
        </button>
        <button
          class="project-tab-btn px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-gray-900/80 dark:bg-gray-900/80 light:bg-white text-gray-300 dark:text-gray-300 light:text-slate-700 border-gray-800 dark:border-gray-800 light:border-slate-300 hover:border-orange-500/40"
          data-category="ai"
        >
          AI & Agentic RAG
        </button>
        <button
          class="project-tab-btn px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-gray-900/80 dark:bg-gray-900/80 light:bg-white text-gray-300 dark:text-gray-300 light:text-slate-700 border-gray-800 dark:border-gray-800 light:border-slate-300 hover:border-orange-500/40"
          data-category="fullstack"
        >
          Full-Stack Web Apps
        </button>
        <button
          class="project-tab-btn px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-gray-900/80 dark:bg-gray-900/80 light:bg-white text-gray-300 dark:text-gray-300 light:text-slate-700 border-gray-800 dark:border-gray-800 light:border-slate-300 hover:border-orange-500/40"
          data-category="ml"
        >
          Computer Vision & ML
        </button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsData.map(project => (
        <div
          class="project-card glass-panel rounded-3xl p-6 flex flex-col justify-between orange-glow-border transition-all duration-300 hover:-translate-y-1.5"
          data-project-category={project.category}
        >
          <div class="space-y-4">
            
            <!-- Category Badge & Metric -->
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-mono font-semibold border border-orange-500/20">
                {project.categoryLabel}
              </span>
              {project.metrics && (
                <span class="text-[11px] font-mono text-emerald-400 flex items-center gap-1 font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                  {project.metrics}
                </span>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-gray-100 dark:text-gray-100 light:text-slate-900 group-hover:text-orange-400 transition-colors">
              {project.title}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-gray-300 dark:text-gray-300 light:text-slate-600 line-clamp-3 leading-relaxed">
              {project.description}
            </p>

            <!-- Key Highlights List -->
            <ul class="space-y-1.5 pt-2 border-t border-gray-800/80">
              {project.highlights.map(h => (
                <li class="flex items-start gap-2 text-xs text-gray-400 dark:text-gray-400 light:text-slate-500">
                  <span class="text-orange-400 font-bold">▸</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Card Footer (Tech Pills + Links) -->
          <div class="pt-6 space-y-4 mt-auto">
            <!-- Tech Stack Pills -->
            <div class="flex flex-wrap gap-1.5">
              {project.technologies.map(tech => (
                <span class="px-2 py-0.5 rounded-md bg-gray-900/80 dark:bg-gray-900/80 light:bg-slate-200 text-gray-300 dark:text-gray-300 light:text-slate-700 text-[11px] font-mono border border-gray-800 dark:border-gray-800 light:border-slate-300">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Action Links -->
            <div class="flex items-center justify-between pt-2 border-t border-gray-800/80">
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-300 hover:text-orange-400 transition-colors"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  <span>Repository</span>
                </a>
              )}

              <button
                class="project-details-btn text-xs font-bold text-orange-400 hover:text-amber-300 flex items-center gap-1 transition-colors"
                data-project-id={project.id}
                data-project-title={project.title}
                data-project-desc={project.longDescription || project.description}
              >
                <span>Details</span>
                <span>→</span>
              </button>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Project Detail Modal -->
<div id="project-detail-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden transition-opacity duration-300">
  <div class="glass-panel w-full max-w-2xl rounded-3xl p-6 sm:p-8 space-y-6 orange-glow-border relative animate-float">
    <button id="close-project-modal" class="absolute top-6 right-6 text-gray-400 hover:text-white text-xl">✕</button>

    <div class="space-y-2">
      <span class="px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-mono font-semibold border border-orange-500/20">
        PROJECT ARCHITECTURE
      </span>
      <h3 id="modal-project-title" class="text-2xl font-extrabold text-gray-100 dark:text-gray-100 light:text-slate-900">
        Project Title
      </h3>
    </div>

    <p id="modal-project-desc" class="text-sm sm:text-base text-gray-300 dark:text-gray-300 light:text-slate-700 leading-relaxed">
      Project detailed description...
    </p>

    <div class="pt-4 border-t border-gray-800 flex justify-end">
      <button id="modal-close-btn" class="px-5 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-semibold text-xs shadow-glow-orange">
        Close
      </button>
    </div>
  </div>
</div>

<script>
  // Project Category Filter Tab Logic
  const tabBtns = document.querySelectorAll('.project-tab-btn');
  const projectCards = document.querySelectorAll('.project-card');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('active', 'bg-orange-500', 'text-white', 'border-orange-500', 'shadow-glow-orange');
        b.classList.add('bg-gray-900/80', 'text-gray-300', 'border-gray-800');
      });

      btn.classList.add('active', 'bg-orange-500', 'text-white', 'border-orange-500', 'shadow-glow-orange');
      btn.classList.remove('bg-gray-900/80', 'text-gray-300', 'border-gray-800');

      const category = btn.getAttribute('data-category');

      projectCards.forEach(card => {
        const cardCat = card.getAttribute('data-project-category');
        if (category === 'all' || cardCat === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Project Detail Modal Logic
  const projectModal = document.getElementById('project-detail-modal');
  const modalTitle = document.getElementById('modal-project-title');
  const modalDesc = document.getElementById('modal-project-desc');
  const closeBtns = [document.getElementById('close-project-modal'), document.getElementById('modal-close-btn')];

  document.querySelectorAll('.project-details-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-project-title') || '';
      const desc = btn.getAttribute('data-project-desc') || '';
      if (modalTitle) modalTitle.textContent = title;
      if (modalDesc) modalDesc.textContent = desc;
      projectModal?.classList.remove('hidden');
    });
  });

  closeBtns.forEach(btn => {
    btn?.addEventListener('click', () => {
      projectModal?.classList.add('hidden');
    });
  });

  projectModal?.addEventListener('click', (e) => {
    if (e.target === projectModal) {
      projectModal.classList.add('hidden');
    }
  });
</script>
