---
import { projectsData } from '../data/portfolioData';
---

<section id="projects" class="py-20 relative border-t border-slate-200 dark:border-gray-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-left max-w-3xl space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-orange-600 dark:text-orange-400 text-xs font-mono font-semibold">
        <span>// FEATURED SYSTEMS & PROJECTS</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-gray-100">
        Engineering & <span class="text-orange-600 dark:text-orange-400">Open-Source Codebases</span>
      </h2>
      <p class="text-slate-600 dark:text-gray-400 text-sm sm:text-base leading-relaxed">
        Production systems across enterprise Multi-Agent RAG, full-stack web applications, and computer vision pipelines.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2 pt-4">
        <button
          class="project-tab-btn active px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-orange-600 text-white border-orange-600 shadow-sm"
          data-category="all"
        >
          All Projects ({projectsData.length})
        </button>
        <button
          class="project-tab-btn px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-slate-100 dark:bg-gray-900/80 text-slate-800 dark:text-gray-300 border-slate-300 dark:border-gray-800 hover:border-orange-500/40"
          data-category="ai"
        >
          AI & Agentic Systems
        </button>
        <button
          class="project-tab-btn px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-slate-100 dark:bg-gray-900/80 text-slate-800 dark:text-gray-300 border-slate-300 dark:border-gray-800 hover:border-orange-500/40"
          data-category="fullstack"
        >
          Full-Stack Web
        </button>
        <button
          class="project-tab-btn px-4 py-2 rounded-xl text-xs font-semibold tracking-wide transition-all border bg-slate-100 dark:bg-gray-900/80 text-slate-800 dark:text-gray-300 border-slate-300 dark:border-gray-800 hover:border-orange-500/40"
          data-category="ml"
        >
          Computer Vision & ML
        </button>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projectsData.map(project => (
        <div
          class="project-card formal-card rounded-2xl p-6 flex flex-col justify-between"
          data-project-category={project.category}
        >
          <div class="space-y-4">
            
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-gray-900/90 text-orange-600 dark:text-orange-400 text-xs font-mono font-semibold border border-slate-300 dark:border-gray-800">
                {project.categoryLabel}
              </span>
              {project.metrics && (
                <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold">
                  {project.metrics}
                </span>
              )}
            </div>

            <h3 class="text-lg font-bold text-slate-900 dark:text-gray-100">
              {project.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 line-clamp-3 leading-relaxed">
              {project.description}
            </p>

            <ul class="space-y-1.5 pt-2 border-t border-slate-200 dark:border-gray-800">
              {project.highlights.map(h => (
                <li class="flex items-start gap-2 text-xs text-slate-600 dark:text-gray-400">
                  <span class="text-orange-600 dark:text-orange-400 font-bold">-</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-6 space-y-4 mt-auto">
            <div class="flex flex-wrap gap-1.5">
              {project.technologies.map(tech => (
                <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-gray-900/80 text-slate-800 dark:text-gray-300 text-[11px] font-mono border border-slate-300 dark:border-gray-800 font-medium">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-slate-200 dark:border-gray-800">
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 transition-colors"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  <span>Repository</span>
                </a>
              )}

              <button
                class="project-details-btn text-xs font-bold text-orange-600 dark:text-orange-400 hover:underline flex items-center gap-1 transition-colors"
                data-project-id={project.id}
                data-project-title={project.title}
                data-project-desc={project.longDescription || project.description}
              >
                <span>View Details</span>
              </button>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Project Detail Modal -->
<div id="project-detail-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden transition-opacity duration-300">
  <div class="formal-card w-full max-w-2xl rounded-2xl p-6 sm:p-8 space-y-6 relative bg-white dark:bg-gray-950">
    <button id="close-project-modal" class="absolute top-6 right-6 text-slate-500 hover:text-slate-900 dark:text-gray-400 dark:hover:text-white text-lg font-mono">✕</button>

    <div class="space-y-1">
      <span class="px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-gray-900 text-orange-600 dark:text-orange-400 text-xs font-mono font-semibold">
        PROJECT ARCHITECTURE
      </span>
      <h3 id="modal-project-title" class="text-xl font-bold text-slate-900 dark:text-gray-100">
        Project Title
      </h3>
    </div>

    <p id="modal-project-desc" class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 leading-relaxed">
      Project detailed description...
    </p>

    <div class="pt-4 border-t border-slate-200 dark:border-gray-800 flex justify-end">
      <button id="modal-close-btn" class="px-4 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white font-semibold text-xs transition-colors">
        Close
      </button>
    </div>
  </div>
</div>

<script>
  const tabBtns = document.querySelectorAll('.project-tab-btn');
  const projectCards = document.querySelectorAll('.project-card');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('active', 'bg-orange-600', 'text-white', 'border-orange-600');
        b.classList.add('bg-slate-100', 'dark:bg-gray-900/80', 'text-slate-800', 'dark:text-gray-300', 'border-slate-300', 'dark:border-gray-800');
      });

      btn.classList.add('active', 'bg-orange-600', 'text-white', 'border-orange-600');
      btn.classList.remove('bg-slate-100', 'dark:bg-gray-900/80', 'text-slate-800', 'dark:text-gray-300', 'border-slate-300', 'dark:border-gray-800');

      const category = btn.getAttribute('data-category');

      projectCards.forEach(card => {
        const cardCat = card.getAttribute('data-project-category');
        if (category === 'all' || cardCat === category) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  const projectModal = document.getElementById('project-detail-modal');
  const modalTitle = document.getElementById('modal-project-title');
  const modalDesc = document.getElementById('modal-project-desc');
  const closeBtns = [document.getElementById('close-project-modal'), document.getElementById('modal-close-btn')];

  document.querySelectorAll('.project-details-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-project-title') || '';
      const desc = btn.getAttribute('data-project-desc') || '';
      if (modalTitle) modalTitle.textContent = title;
      if (modalDesc) modalDesc.textContent = desc;
      projectModal?.classList.remove('hidden');
    });
  });

  closeBtns.forEach(btn => {
    btn?.addEventListener('click', () => {
      projectModal?.classList.add('hidden');
    });
  });

  projectModal?.addEventListener('click', (e) => {
    if (e.target === projectModal) {
      projectModal.classList.add('hidden');
    }
  });
</script>
