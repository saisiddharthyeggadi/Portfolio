---
import { personalData } from '../data/portfolioData';
---

<section id="about" class="py-20 relative border-t border-slate-200 dark:border-gray-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-left max-w-3xl space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-orange-600 dark:text-orange-400 text-xs font-mono font-semibold">
        <span>// ABOUT & BACKGROUND</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-gray-100">
        Engineered at IIT Hyderabad, <span class="text-orange-600 dark:text-orange-400">Operating in Tokyo</span>
      </h2>
      <p class="text-slate-600 dark:text-gray-400 text-sm sm:text-base leading-relaxed">
        Combining strong computer science foundations with real-world enterprise AI deployment in Japan.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Bio Summary Card (Left Column) -->
      <div class="lg:col-span-7 formal-card rounded-2xl p-6 sm:p-8 space-y-6">
        <h3 class="text-xl font-bold text-slate-900 dark:text-gray-100">
          Professional Profile
        </h3>
        
        <p class="text-sm text-slate-700 dark:text-gray-300 leading-relaxed">
          {personalData.bio}
        </p>

        <!-- Core Pillars -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-200 dark:border-gray-800">
          <div class="space-y-1">
            <h4 class="text-xs font-mono font-bold text-orange-600 dark:text-orange-400 uppercase">
              Agentic RAG & GCP
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-400 leading-normal">
              Building enterprise AI agents using Google ADK, Model Context Protocol (MCP), and Vertex AI semantic vector search.
            </p>
          </div>

          <div class="space-y-1">
            <h4 class="text-xs font-mono font-bold text-orange-600 dark:text-orange-400 uppercase">
              Full-Stack & Computer Vision
            </h4>
            <p class="text-xs text-slate-600 dark:text-gray-400 leading-normal">
              Architecting full-stack web solutions (Angular, Node.js, TypeScript) and high-accuracy PyTorch/CNN pipelines.
            </p>
          </div>
        </div>

        <!-- Language Matrix -->
        <div class="pt-4 border-t border-slate-200 dark:border-gray-800 space-y-3">
          <h4 class="text-xs font-mono font-bold text-slate-900 dark:text-gray-200 uppercase">
            Language Capabilities
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {personalData.languages.map(lang => (
              <div class="p-3 rounded-xl bg-slate-100 dark:bg-gray-900/60 border border-slate-300 dark:border-gray-800 flex justify-between items-center text-xs">
                <span class="font-bold text-slate-800 dark:text-gray-200">{lang.name}</span>
                <span class="text-slate-600 dark:text-gray-400 font-mono text-[11px]">{lang.level}</span>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Education & Academic Highlight (Right Column) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="formal-card rounded-2xl p-6 sm:p-8 space-y-6">
          <div class="space-y-1">
            <span class="text-xs font-mono text-orange-600 dark:text-orange-400 font-bold uppercase">
              Alma Mater
            </span>
            <h3 class="text-xl font-bold text-slate-900 dark:text-gray-100">
              {personalData.education.institution}
            </h3>
            <p class="text-xs font-mono text-slate-600 dark:text-gray-400">
              {personalData.education.degree} ({personalData.education.period})
            </p>
          </div>

          <div class="p-3 rounded-xl bg-slate-100 dark:bg-gray-900/60 border border-slate-300 dark:border-gray-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-700 dark:text-gray-300">Cumulative GPA</span>
            <span class="text-sm font-bold font-mono text-slate-900 dark:text-gray-100">{personalData.education.gpa}</span>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-mono font-bold text-slate-800 dark:text-gray-300 uppercase">
              Relevant Computer Science Coursework
            </h4>
            <div class="flex flex-wrap gap-1.5">
              {personalData.education.keyCoursework.map(course => (
                <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-gray-900 text-slate-800 dark:text-gray-300 text-xs border border-slate-300 dark:border-gray-800 font-medium">
                  {course}
                </span>
              ))}
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
