---
import { personalData } from '../data/portfolioData';
---

<section id="about" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono font-semibold">
        <span>// ABOUT ME</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Engineering Intelligence at the <span class="orange-gradient-text">Intersection of AI & Systems</span>
      </h2>
      <p class="text-gray-400 dark:text-gray-400 light:text-slate-600 text-base">
        Bridging global AI innovation with local enterprise infrastructure in Tokyo, Japan.
      </p>
    </div>

    <!-- Main About Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Bio & Background Card -->
      <div class="lg:col-span-7 glass-panel rounded-3xl p-8 space-y-6 flex flex-col justify-between orange-glow-border">
        <div class="space-y-4">
          <div class="flex items-center gap-3 text-orange-400 font-mono text-sm font-semibold">
            <span class="w-8 h-[2px] bg-orange-500"></span>
            <span>BACKGROUND & PHILOSOPHY</span>
          </div>

          <h3 class="text-2xl font-bold text-gray-100 dark:text-gray-100 light:text-slate-900">
            Tokyo-Based Systems & AI Engineer
          </h3>

          <p class="text-gray-300 dark:text-gray-300 light:text-slate-700 leading-relaxed text-sm sm:text-base">
            I graduated from <strong class="text-orange-400 font-semibold">IIT Hyderabad</strong> with a strong foundation in Computer Science, Data Structures & Algorithms (JEE Advanced AIR 2,824). My professional focus centers on building reliable, customer-facing <strong class="text-gray-100 dark:text-gray-100 light:text-slate-900 font-semibold">Multi-Agent RAG systems</strong> and high-performance full-stack web applications.
          </p>

          <p class="text-gray-300 dark:text-gray-300 light:text-slate-700 leading-relaxed text-sm sm:text-base">
            Currently working as a Systems Development Engineer at <strong class="text-orange-400 font-semibold">Tomato CO., Ltd. in Tokyo</strong>, I lead technical localization and deployment over Google Cloud Platform (Vertex AI, Google ADK, MCP tool-calling), directly engaging with Japanese corporate stakeholders.
          </p>
        </div>

        <!-- Languages Matrix -->
        <div class="pt-4 border-t border-gray-800/80 space-y-3">
          <p class="text-xs font-mono text-orange-400 font-semibold uppercase tracking-wider">Linguistic & Cultural Agility</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {personalData.languages.map(lang => (
              <div class="bg-gray-900/60 dark:bg-gray-900/60 light:bg-slate-100 p-3 rounded-xl border border-gray-800/80 dark:border-gray-800/80 light:border-slate-200 text-center">
                <p class="text-sm font-bold text-gray-200 dark:text-gray-200 light:text-slate-800">{lang.name}</p>
                <p class="text-[11px] text-gray-400 dark:text-gray-400 light:text-slate-500 mt-0.5">{lang.level}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Education & IIT Hyderabad Highlight Card -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- IIT Hyderabad Card -->
        <div class="glass-panel rounded-3xl p-6 space-y-4 border-l-4 border-l-orange-500">
          <div class="flex items-start justify-between">
            <div class="w-12 h-12 rounded-2xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 text-2xl">
              🎓
            </div>
            <span class="px-3 py-1 rounded-full bg-gray-900/80 text-orange-400 text-xs font-mono font-semibold border border-gray-800">
              {personalData.education.period}
            </span>
          </div>

          <div>
            <h4 class="text-xl font-bold text-gray-100 dark:text-gray-100 light:text-slate-900">
              {personalData.education.institution}
            </h4>
            <p class="text-sm text-orange-400 font-medium mt-0.5">{personalData.education.degree}</p>
            <p class="text-xs text-gray-400 dark:text-gray-400 light:text-slate-500 mt-1">Cumulative GPA: <strong class="text-gray-200 dark:text-gray-200 light:text-slate-700">{personalData.education.gpa}</strong></p>
          </div>

          <div class="space-y-2 pt-2 border-t border-gray-800/80">
            <p class="text-xs font-mono text-gray-400 dark:text-gray-400 light:text-slate-500">Core Coursework:</p>
            <div class="flex flex-wrap gap-1.5">
              {personalData.education.keyCoursework.map(course => (
                <span class="px-2.5 py-1 rounded-lg bg-gray-900/60 dark:bg-gray-900/60 light:bg-slate-200 text-gray-300 dark:text-gray-300 light:text-slate-700 text-xs font-mono border border-gray-800 dark:border-gray-800 light:border-slate-300">
                  {course}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Career Principles Card -->
        <div class="glass-panel rounded-3xl p-6 space-y-3 bg-gradient-to-br from-orange-500/5 to-transparent">
          <div class="flex items-center gap-2 text-orange-400 text-sm font-semibold font-mono">
            <span>💡</span>
            <span>ENGINEERING FOCUS</span>
          </div>
          <ul class="space-y-2.5 text-xs sm:text-sm text-gray-300 dark:text-gray-300 light:text-slate-700">
            <li class="flex items-start gap-2">
              <span class="text-orange-400 mt-0.5">▸</span>
              <span><strong>Zero-Hallucination RAG:</strong> Implementing rigid agent orchestration (MCP, ADK) and evaluation guardrails.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-orange-400 mt-0.5">▸</span>
              <span><strong>Bilingual Localization:</strong> Fluent technical translation & client engagement in Japanese and English.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-orange-400 mt-0.5">▸</span>
              <span><strong>Algorithmic Excellence:</strong> 475+ LeetCode problems solved with 365-day consistency.</span>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </div>
</section>
