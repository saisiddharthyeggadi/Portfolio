---
import { resumeOptions } from '../data/portfolioData';
---

<!-- Resume Selection & Preview Modal -->
<div id="resume-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-black/85 backdrop-blur-md hidden transition-all duration-300">
  <div class="glass-panel w-full max-w-5xl h-[90vh] rounded-3xl p-6 sm:p-8 flex flex-col orange-glow-border relative animate-float">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-gray-800 pb-4 mb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 text-xl font-bold">
          📄
        </div>
        <div>
          <h3 class="text-xl font-extrabold text-gray-100 dark:text-gray-100 light:text-slate-900">
            Curriculum Vitae / Specialized Resumes
          </h3>
          <p class="text-xs text-gray-400 dark:text-gray-400 light:text-slate-600">
            Select a specialized resume version tailored for specific engineering roles.
          </p>
        </div>
      </div>
      <button id="close-resume-modal" class="p-2 rounded-xl text-gray-400 hover:text-white hover:bg-gray-800 text-xl transition-colors">✕</button>
    </div>

    <!-- Resume Variant Selector Tabs -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">
      {resumeOptions.map((res, index) => (
        <button
          class={`resume-tab-btn px-3 py-2.5 rounded-xl text-xs text-left transition-all border ${
            index === 0
              ? 'active bg-orange-500 text-white border-orange-500 shadow-glow-orange'
              : 'bg-gray-900/80 dark:bg-gray-900/80 light:bg-slate-100 text-gray-300 dark:text-gray-300 light:text-slate-700 border-gray-800 dark:border-gray-800 light:border-slate-300 hover:border-orange-500/40'
          }`}
          data-pdf-src={`/resumes/${res.filename}`}
          data-pdf-filename={res.filename}
          data-pdf-title={res.title}
        >
          <p class="font-bold truncate">{res.roleTag}</p>
          <p class="text-[10px] opacity-80 truncate">{res.title}</p>
        </button>
      ))}
    </div>

    <!-- Active Resume Details & Download Bar -->
    <div class="flex items-center justify-between bg-gray-900/60 dark:bg-gray-900/60 light:bg-slate-100 px-4 py-3 rounded-2xl border border-gray-800/80 mb-4">
      <div>
        <p id="selected-resume-title" class="text-sm font-bold text-orange-400">
          {resumeOptions[0].title}
        </p>
        <p id="selected-resume-filename" class="text-xs font-mono text-gray-400">
          {resumeOptions[0].filename}
        </p>
      </div>

      <a
        id="download-resume-btn"
        href={`/resumes/${resumeOptions[0].filename}`}
        download={resumeOptions[0].filename}
        class="px-5 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-semibold text-xs shadow-glow-orange flex items-center gap-2 transition-all hover:scale-105"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>Download PDF</span>
      </a>
    </div>

    <!-- Embedded PDF Viewer / Iframe -->
    <div class="flex-1 w-full bg-gray-950 rounded-2xl overflow-hidden border border-gray-800/80 relative">
      <iframe
        id="resume-iframe"
        src={`/resumes/${resumeOptions[0].filename}`}
        class="w-full h-full border-0"
        title="Resume PDF Preview"
      ></iframe>
    </div>

  </div>
</div>

<script>
  // Resume Modal Open/Close Logic
  const openResumeBtn = document.getElementById('open-resume-btn');
  const resumeModal = document.getElementById('resume-modal');
  const closeResumeModal = document.getElementById('close-resume-modal');
  const resumeTabs = document.querySelectorAll('.resume-tab-btn');
  
  const iframe = document.getElementById('resume-iframe') as HTMLIFrameElement | null;
  const titleEl = document.getElementById('selected-resume-title');
  const filenameEl = document.getElementById('selected-resume-filename');
  const downloadBtn = document.getElementById('download-resume-btn') as HTMLAnchorElement | null;

  openResumeBtn?.addEventListener('click', () => {
    resumeModal?.classList.remove('hidden');
  });

  closeResumeModal?.addEventListener('click', () => {
    resumeModal?.classList.add('hidden');
  });

  resumeModal?.addEventListener('click', (e) => {
    if (e.target === resumeModal) {
      resumeModal.classList.add('hidden');
    }
  });

  // Tab Selection Switcher
  resumeTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      resumeTabs.forEach(t => {
        t.classList.remove('active', 'bg-orange-500', 'text-white', 'border-orange-500', 'shadow-glow-orange');
        t.classList.add('bg-gray-900/80', 'text-gray-300', 'border-gray-800');
      });

      tab.classList.add('active', 'bg-orange-500', 'text-white', 'border-orange-500', 'shadow-glow-orange');
      tab.classList.remove('bg-gray-900/80', 'text-gray-300', 'border-gray-800');

      const src = tab.getAttribute('data-pdf-src') || '';
      const filename = tab.getAttribute('data-pdf-filename') || '';
      const title = tab.getAttribute('data-pdf-title') || '';

      if (iframe) iframe.src = src;
      if (titleEl) titleEl.textContent = title;
      if (filenameEl) filenameEl.textContent = filename;
      if (downloadBtn) {
        downloadBtn.href = src;
        downloadBtn.download = filename;
      }
    });
  });
</script>
