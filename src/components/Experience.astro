---
import { experiencesData } from '../data/portfolioData';
---

<section id="experience" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono font-semibold">
        <span>// CAREER & EXPERIENCE</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Proven Track Record in <span class="orange-gradient-text">Production Engineering</span>
      </h2>
      <p class="text-gray-400 dark:text-gray-400 light:text-slate-600 text-base">
        From multi-agent RAG solutions in Tokyo to LLM evaluation at Kore.ai and computer vision pipelines at Ojas.
      </p>
    </div>

    <!-- Vertical Timeline Wrapper -->
    <div class="relative border-l-2 border-orange-500/30 ml-4 md:ml-32 space-y-12">
      {experiencesData.map((exp, index) => (
        <div class="relative pl-6 md:pl-10 group">
          
          <!-- Timeline Glowing Node Dot -->
          <div class="absolute -left-[17px] top-1.5 w-8 h-8 rounded-full bg-[#0b0f17] dark:bg-[#0b0f17] light:bg-white border-2 border-orange-500 flex items-center justify-center group-hover:scale-125 group-hover:bg-orange-500 group-hover:shadow-glow-orange transition-all duration-300">
            <div class="w-2.5 h-2.5 rounded-full bg-orange-400 group-hover:bg-white"></div>
          </div>

          <!-- Date Badge for Desktop (Left aligned) -->
          <div class="hidden md:block absolute -left-36 top-2 text-right w-28 text-xs font-mono font-semibold text-orange-400">
            {exp.period}
          </div>

          <!-- Experience Card -->
          <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-4 orange-glow-border">
            
            <div class="flex flex-wrap items-start justify-between gap-2 border-b border-gray-800/80 pb-4">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-bold text-gray-100 dark:text-gray-100 light:text-slate-900">{exp.role}</h3>
                  {exp.isCurrent && (
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-mono font-semibold animate-pulse">
                      PRESENT
                    </span>
                  )}
                </div>
                <p class="text-sm font-semibold text-orange-400 mt-0.5">
                  {exp.company} • <span class="text-gray-400 dark:text-gray-400 light:text-slate-500 font-normal">{exp.location}</span>
                </p>
              </div>

              <!-- Mobile Date Badge -->
              <span class="md:hidden px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-mono border border-orange-500/20">
                {exp.period}
              </span>
            </div>

            <!-- Summary -->
            <p class="text-sm text-gray-300 dark:text-gray-300 light:text-slate-700 italic">
              "{exp.summary}"
            </p>

            <!-- Key Quantified Achievements -->
            <ul class="space-y-2.5 pt-2">
              {exp.achievements.map(ach => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-gray-300 dark:text-gray-300 light:text-slate-700 leading-relaxed">
                  <span class="text-orange-400 font-bold mt-0.5">✓</span>
                  <span>{ach}</span>
                </li>
              ))}
            </ul>

            <!-- Tech Stack Badges -->
            <div class="pt-4 border-t border-gray-800/80 flex flex-wrap gap-2">
              {exp.technologies.map(tech => (
                <span class="px-3 py-1 rounded-lg bg-gray-900/80 dark:bg-gray-900/80 light:bg-slate-200 text-gray-300 dark:text-gray-300 light:text-slate-700 text-xs font-mono border border-gray-800 dark:border-gray-800 light:border-slate-300">
                  {tech}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
