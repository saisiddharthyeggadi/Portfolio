---
import { experiencesData } from '../data/portfolioData';
---

<section id="experience" class="py-20 relative border-t border-slate-200 dark:border-gray-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-left max-w-3xl space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-orange-600 dark:text-orange-400 text-xs font-mono font-semibold">
        <span>// CAREER & EXPERIENCE</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-gray-100">
        Professional <span class="text-orange-600 dark:text-orange-400">Work Experience</span>
      </h2>
      <p class="text-slate-600 dark:text-gray-400 text-sm sm:text-base leading-relaxed">
        Engineering roles spanning full-time Tokyo systems development, enterprise GenAI pipelines, and computer vision research.
      </p>
    </div>

    <!-- Experience Timeline List -->
    <div class="space-y-6">
      {experiencesData.map((exp) => (
        <div class="formal-card rounded-2xl p-6 sm:p-8 space-y-6">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-gray-800 pb-4">
            <div>
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-slate-900 dark:text-gray-100">
                  {exp.role}
                </h3>
                {exp.isCurrent && (
                  <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-mono font-semibold border border-emerald-500/20">
                    Current Role
                  </span>
                )}
              </div>
              <p class="text-sm font-semibold text-orange-600 dark:text-orange-400 font-mono mt-0.5">
                {exp.company} — {exp.location}
              </p>
            </div>

            <div class="text-left sm:text-right">
              <span class="text-xs font-mono text-slate-600 dark:text-gray-400 block">
                {exp.period}
              </span>
              <span class="text-[11px] font-mono text-slate-500 dark:text-gray-500 uppercase">
                {exp.type}
              </span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-slate-700 dark:text-gray-300 leading-relaxed">
            {exp.summary}
          </p>

          <!-- Key Deliverables List -->
          <div class="space-y-2">
            <h4 class="text-xs font-mono font-bold text-slate-800 dark:text-gray-300 uppercase">
              Key Engineering Deliverables
            </h4>
            <ul class="space-y-2">
              {exp.achievements.map(item => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-gray-300">
                  <span class="text-orange-600 dark:text-orange-400 font-bold mt-0.5">-</span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tech Stack Tags -->
          <div class="pt-4 border-t border-slate-200 dark:border-gray-800 flex flex-wrap gap-1.5">
            {exp.technologies.map(tech => (
              <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-gray-900/90 text-slate-800 dark:text-gray-300 text-xs font-mono border border-slate-300 dark:border-gray-800">
                {tech}
              </span>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
