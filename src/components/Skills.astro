---
import { skillsCategories } from '../data/portfolioData';
---

<section id="skills" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-mono font-semibold">
        <span>// SKILLS & TECHNICAL MATRIX</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Comprehensive <span class="orange-gradient-text">Tech Stack</span>
      </h2>
      <p class="text-gray-400 dark:text-gray-400 light:text-slate-600 text-base">
        Categorized technical proficiencies across Artificial Intelligence, Cloud Systems, and Full-Stack Engineering.
      </p>

      <!-- Skill Search Input -->
      <div class="pt-4 max-w-md mx-auto relative">
        <input
          type="text"
          id="skill-search-input"
          placeholder="Filter skills (e.g. PyTorch, TypeScript, RAG, Angular)..."
          class="w-full px-5 py-3 rounded-2xl bg-gray-900/80 dark:bg-gray-900/80 light:bg-white border border-gray-800 dark:border-gray-800 light:border-slate-300 text-sm text-gray-200 dark:text-gray-200 light:text-slate-900 placeholder-gray-500 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all shadow-lg"
        />
        <span class="absolute right-4 top-3.5 text-gray-500 text-sm">🔍</span>
      </div>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillsCategories.map((category, catIdx) => (
        <div class="glass-panel rounded-3xl p-6 sm:p-8 space-y-6 orange-glow-border skill-card-container">
          
          <!-- Category Header -->
          <div class="flex items-center justify-between border-b border-gray-800/80 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400 font-bold">
                {catIdx === 0 ? '🤖' : catIdx === 1 ? '💻' : catIdx === 2 ? '🧠' : '⚡'}
              </div>
              <h3 class="text-xl font-bold text-gray-100 dark:text-gray-100 light:text-slate-900">{category.title}</h3>
            </div>
            <span class="text-xs text-orange-400 font-mono">{category.skills.length} Skills</span>
          </div>

          <!-- Skills Bars -->
          <div class="space-y-4">
            {category.skills.map(skill => (
              <div class="skill-item space-y-1.5" data-skill-name={skill.name.toLowerCase()}>
                <div class="flex justify-between items-center text-xs sm:text-sm font-medium">
                  <span class="flex items-center gap-2 text-gray-200 dark:text-gray-200 light:text-slate-800">
                    {skill.name}
                    {skill.highlight && (
                      <span class="px-1.5 py-0.5 text-[9px] font-mono font-bold bg-orange-500/20 text-orange-400 rounded border border-orange-500/30">
                        TOP
                      </span>
                    )}
                  </span>
                  <span class="font-mono text-orange-400 text-xs">{skill.level}%</span>
                </div>
                <!-- Progress Bar -->
                <div class="w-full h-2 rounded-full bg-gray-900/90 dark:bg-gray-900/90 light:bg-slate-200 overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-orange-500 to-amber-400 rounded-full transition-all duration-1000 ease-out shadow-glow-orange"
                    style={`width: ${skill.level}%`}
                  ></div>
                </div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Dynamic Skill Search Filter
  const searchInput = document.getElementById('skill-search-input') as HTMLInputElement | null;
  const skillItems = document.querySelectorAll('.skill-item');
  const cardContainers = document.querySelectorAll('.skill-card-container');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    
    skillItems.forEach(item => {
      const name = item.getAttribute('data-skill-name') || '';
      if (name.includes(query)) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    // Hide empty card containers if no skills match query
    cardContainers.forEach(card => {
      const visibleItems = card.querySelectorAll('.skill-item[style="display: block;"], .skill-item:not([style*="display: none"])');
      if (visibleItems.length === 0 && query !== '') {
        (card as HTMLElement).style.opacity = '0.3';
      } else {
        (card as HTMLElement).style.opacity = '1';
      }
    });
  });
</script>
