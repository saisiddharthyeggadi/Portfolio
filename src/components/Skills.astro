---
import { skillsCategories } from '../data/portfolioData';
---

<section id="skills" class="py-20 relative border-t border-slate-200 dark:border-gray-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-left max-w-3xl space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-orange-600 dark:text-orange-400 text-xs font-mono font-semibold">
        <span>// TECHNICAL CAPABILITIES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-gray-100">
        Skills & <span class="text-orange-600 dark:text-orange-400">Technical Competencies</span>
      </h2>
      <p class="text-slate-600 dark:text-gray-400 text-sm sm:text-base leading-relaxed">
        Categorized overview of engineering frameworks, machine learning libraries, web technologies, and systems tooling.
      </p>
    </div>

    <!-- Real-time Skill Search Bar -->
    <div class="mb-10 max-w-md">
      <div class="relative">
        <input
          type="text"
          id="skill-search-input"
          placeholder="Filter skills by keyword (e.g. PyTorch, GCP, Angular)..."
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-gray-900/80 border border-slate-300 dark:border-gray-800 text-xs sm:text-sm text-slate-900 dark:text-gray-100 placeholder-slate-400 dark:placeholder-gray-500 focus:outline-none focus:border-orange-500 transition-colors font-mono"
        />
        <div class="absolute right-3 top-3 text-xs text-slate-500 dark:text-gray-500 font-mono">
          Search
        </div>
      </div>
    </div>

    <!-- Skills Category Grid (Boxed Pills Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillsCategories.map(cat => (
        <div class="formal-card rounded-2xl p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-200 dark:border-gray-800 pb-3">
            <h3 class="text-base font-bold text-slate-900 dark:text-gray-100">
              {cat.title}
            </h3>
            <span class="text-xs font-mono text-orange-600 dark:text-orange-400 font-semibold">
              {cat.skills.length} Technologies
            </span>
          </div>

          <!-- Boxed Skill Tags -->
          <div class="flex flex-wrap gap-2.5">
            {cat.skills.map(skill => (
              <div
                class="skill-box-item motion-pill px-4 py-2 rounded-xl bg-slate-100 dark:bg-gray-900/90 border border-slate-300 dark:border-gray-800 text-xs sm:text-sm font-semibold text-slate-800 dark:text-gray-200 hover:border-orange-500/50 hover:text-orange-600 dark:hover:text-orange-400 transition-all cursor-default"
                data-skill-name={skill.toLowerCase()}
              >
                {skill}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const searchInput = document.getElementById('skill-search-input') as HTMLInputElement | null;
  const skillBoxes = document.querySelectorAll('.skill-box-item');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

    skillBoxes.forEach(box => {
      const skillName = box.getAttribute('data-skill-name') || '';
      if (query === '' || skillName.includes(query)) {
        (box as HTMLElement).style.display = 'inline-block';
        (box as HTMLElement).style.opacity = '1';
      } else {
        (box as HTMLElement).style.display = 'none';
        (box as HTMLElement).style.opacity = '0';
      }
    });
  });
</script>
